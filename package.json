{
  "name": "dock-project-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/bundle-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:private": "npm run build && wrangler deploy",
    "check:worker": "npm run build && wrangler deploy --dry-run --outdir work/worker-build"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  }
}
