{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dock-private",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "OWNER_EMAIL": "ethan.grandpre0360@gmail.com"
  },
  "observability": { "enabled": false }
}
