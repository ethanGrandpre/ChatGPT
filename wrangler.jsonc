{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "OWNER_EMAIL": "ethan.grandpre0360@gmail.com"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_PUSH",
        "class_name": "TaskPush"
      },
      {
        "name": "GROUPME_PUSH",
        "class_name": "GroupMePush"
      },
      {
        "name": "VIDEO_ROOMS",
        "class_name": "VideoRoom"
      },
      {
        "name": "MEMBER_ACCOUNTS",
        "class_name": "MemberAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "tasks-push-v1",
      "new_sqlite_classes": [
        "TaskPush"
      ]
    },
    {
      "tag": "groupme-push-v1",
      "new_sqlite_classes": [
        "GroupMePush"
      ]
    },
    {
      "tag": "video-call-v1",
      "new_sqlite_classes": [
        "VideoRoom"
      ]
    },
    {
      "tag": "member-workspace-v1",
      "new_sqlite_classes": [
        "MemberAccount"
      ]
    }
  ]
}
